{
  "properties": {
    "displayName": "KPI Breach Alert",
    "description": "Checks each tracked KPI daily against its tolerance threshold and alerts the KPI owner and finance leadership channel when a KPI is outside tolerance.",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "UTC",
            "schedule": {
              "hours": [7]
            }
          }
        }
      },
      "actions": {
        "Get_KPI_records": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "YOUR_SHAREPOINT_SITE_URL",
              "table": "KPI Tracking",
              "$filter": ""
            }
          },
          "runAfter": {}
        },
        "Apply_to_each_KPI": {
          "type": "Foreach",
          "foreach": "@outputs('Get_KPI_records')?['body/value']",
          "actions": {
            "Check_KPI_breach": {
              "type": "If",
              "expression": {
                "greater": [
                  "@items('Apply_to_each_KPI')?['VariancePercent']",
                  "@items('Apply_to_each_KPI')?['ToleranceThreshold']"
                ]
              },
              "actions": {
                "Alert_KPI_owner_Teams": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_teams",
                      "operationId": "PostMessageToChannel",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Channel",
                      "channel": "YOUR_FINANCE_LEADERSHIP_CHANNEL_ID",
                      "message": "@concat('KPI breach: ', items('Apply_to_each_KPI')?['KPIName'], ' is at ', items('Apply_to_each_KPI')?['CurrentValue'], ', outside the tolerance of ', items('Apply_to_each_KPI')?['ToleranceThreshold'])"
                    }
                  },
                  "runAfter": {}
                },
                "Email_KPI_owner": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@items('Apply_to_each_KPI')?['OwnerEmail']",
                      "emailMessage/Subject": "@concat('KPI breach: ', items('Apply_to_each_KPI')?['KPIName'])",
                      "emailMessage/Body": "@concat('Your KPI “', items('Apply_to_each_KPI')?['KPIName'], '” is currently outside its agreed tolerance. Current value: ', items('Apply_to_each_KPI')?['CurrentValue'], '.')"
                    }
                  },
                  "runAfter": {
                    "Alert_KPI_owner_Teams": ["Succeeded"]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Get_KPI_records": ["Succeeded"]
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "YOUR_SHAREPOINT_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified"
      },
      "shared_teams": {
        "connectionName": "YOUR_TEAMS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "YOUR_OUTLOOK_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      }
    }
  }
}
