{
  "properties": {
    "displayName": "Expense Policy Alert",
    "description": "Flags expense submissions over a per-category threshold or in a restricted category, alerting compliance and the submitter's manager.",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "YOUR_SHAREPOINT_SITE_URL",
              "table": "Expense Reports"
            }
          },
          "splitOn": null,
          "metadata": {
            "_note": "Replace 'dataset' with your SharePoint site URL and confirm 'table' matches your 'Expense Reports' list exactly."
          }
        }
      },
      "actions": {
        "Check_policy_violation": {
          "type": "If",
          "expression": {
            "or": [
              {
                "greater": ["@triggerBody()?['Amount']", 500]
              },
              {
                "equals": ["@triggerBody()?['Category']", "Alcohol"]
              }
            ]
          },
          "actions": {
            "Update_item_Flagged": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "YOUR_SHAREPOINT_SITE_URL",
                  "table": "Expense Reports",
                  "id": "@triggerBody()?['ID']",
                  "item": {
                    "Status": "Flagged for Review"
                  }
                }
              },
              "runAfter": {}
            },
            "Alert_compliance_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_teams",
                  "operationId": "PostMessageToChannel",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "channel": "YOUR_COMPLIANCE_CHANNEL_ID",
                  "message": "@concat('Policy flag: expense report ', triggerBody()?['ID'], ' by ', triggerBody()?['Author']?['DisplayName'], ' — amount ', triggerBody()?['Amount'], ' in category ', triggerBody()?['Category'])"
                }
              },
              "runAfter": {
                "Update_item_Flagged": ["Succeeded"]
              }
            },
            "Get_manager_of_submitter": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365users",
                  "operationId": "UserProfileV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users"
                },
                "parameters": {
                  "userId": "@triggerBody()?['Author']?['Email']"
                }
              },
              "runAfter": {
                "Alert_compliance_channel": ["Succeeded"]
              },
              "metadata": {
                "_note": "This is the 'Get manager (V2)' action — resolves the approver dynamically rather than a hardcoded email."
              }
            },
            "Notify_manager_of_flag": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@body('Get_manager_of_submitter')?['mail']",
                  "emailMessage/Subject": "@concat('Expense policy flag for ', triggerBody()?['Author']?['DisplayName'])",
                  "emailMessage/Body": "@concat('This expense report requires your review before approval: amount ', triggerBody()?['Amount'], ', category ', triggerBody()?['Category'], '.')"
                }
              },
              "runAfter": {
                "Get_manager_of_submitter": ["Succeeded"]
              }
            }
          },
          "else": {
            "actions": {
              "Update_item_Compliant": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "YOUR_SHAREPOINT_SITE_URL",
                    "table": "Expense Reports",
                    "id": "@triggerBody()?['ID']",
                    "item": {
                      "Status": "Compliant"
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {}
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "YOUR_SHAREPOINT_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified"
      },
      "shared_teams": {
        "connectionName": "YOUR_TEAMS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
        "tier": "NotSpecified"
      },
      "shared_office365users": {
        "connectionName": "YOUR_OFFICE365USERS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365users",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "YOUR_OUTLOOK_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      }
    }
  }
}
