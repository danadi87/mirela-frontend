{
  "properties": {
    "displayName": "Budget Overrun Notification",
    "description": "Calculates budget variance whenever a budget tracking record is created or updated, and alerts the budget owner, their manager, and finance leadership when spend exceeds a 10% tolerance.",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_an_item_is_created_or_modified": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "YOUR_SHAREPOINT_SITE_URL",
              "table": "Budget Tracking"
            }
          },
          "splitOn": null,
          "metadata": {
            "_note": "Replace 'dataset' with your SharePoint site URL and confirm 'table' matches your 'Budget Tracking' list exactly."
          }
        }
      },
      "actions": {
        "Calculate_variance_percent": {
          "type": "Compose",
          "inputs": "@mul(div(sub(triggerBody()?['ActualSpend'], triggerBody()?['BudgetAmount']), triggerBody()?['BudgetAmount']), 100)",
          "runAfter": {}
        },
        "Check_overrun_tolerance": {
          "type": "If",
          "expression": {
            "greater": ["@outputs('Calculate_variance_percent')", 10]
          },
          "actions": {
            "Get_manager_of_budget_owner": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365users",
                  "operationId": "UserProfileV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users"
                },
                "parameters": {
                  "userId": "@triggerBody()?['BudgetOwnerEmail']"
                }
              },
              "runAfter": {},
              "metadata": {
                "_note": "This is the 'Get manager (V2)' action — resolves the approver dynamically rather than a hardcoded email."
              }
            },
            "Email_budget_owner_and_manager": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@concat(triggerBody()?['BudgetOwnerEmail'], ';', body('Get_manager_of_budget_owner')?['mail'])",
                  "emailMessage/Subject": "@concat('Budget overrun: ', triggerBody()?['BudgetLineName'])",
                  "emailMessage/Body": "@concat('Budget line “', triggerBody()?['BudgetLineName'], '” is running ', string(outputs('Calculate_variance_percent')), '% over budget. Actual: ', triggerBody()?['ActualSpend'], ', Budget: ', triggerBody()?['BudgetAmount'], '.')"
                }
              },
              "runAfter": {
                "Get_manager_of_budget_owner": ["Succeeded"]
              }
            },
            "Alert_finance_leadership_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_teams",
                  "operationId": "PostMessageToChannel",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "channel": "YOUR_FINANCE_LEADERSHIP_CHANNEL_ID",
                  "message": "@concat('Budget overrun flagged: ', triggerBody()?['BudgetLineName'], ' at ', string(outputs('Calculate_variance_percent')), '% over.')"
                }
              },
              "runAfter": {
                "Email_budget_owner_and_manager": ["Succeeded"]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Calculate_variance_percent": ["Succeeded"]
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "YOUR_SHAREPOINT_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified"
      },
      "shared_office365users": {
        "connectionName": "YOUR_OFFICE365USERS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365users",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "YOUR_OUTLOOK_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      },
      "shared_teams": {
        "connectionName": "YOUR_TEAMS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
        "tier": "NotSpecified"
      }
    }
  }
}
