{
  "properties": {
    "displayName": "Month-End Close Reminder",
    "description": "Runs on a monthly schedule, reminds owners of any incomplete close tasks individually, and posts a summary count to the Finance Close Teams channel.",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Month",
            "interval": 1,
            "timeZone": "UTC",
            "schedule": {
              "monthDays": [25]
            }
          }
        }
      },
      "actions": {
        "Get_incomplete_close_tasks": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "YOUR_SHAREPOINT_SITE_URL",
              "table": "Close Tasks",
              "$filter": "Status ne 'Complete'"
            }
          },
          "runAfter": {}
        },
        "Apply_to_each_task": {
          "type": "Foreach",
          "foreach": "@outputs('Get_incomplete_close_tasks')?['body/value']",
          "actions": {
            "Send_reminder_to_task_owner": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@items('Apply_to_each_task')?['OwnerEmail']",
                  "emailMessage/Subject": "@concat('Reminder: close task due — ', items('Apply_to_each_task')?['Title'])",
                  "emailMessage/Body": "@concat('This month-end close task is not yet marked complete: ', items('Apply_to_each_task')?['Title'], '. Please complete it or flag a blocker.')"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Get_incomplete_close_tasks": ["Succeeded"]
          }
        },
        "Post_summary_to_close_channel": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostMessageToChannel",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
            },
            "parameters": {
              "poster": "Flow bot",
              "location": "Channel",
              "channel": "YOUR_FINANCE_CLOSE_CHANNEL_ID",
              "message": "@concat(length(outputs('Get_incomplete_close_tasks')?['body/value']), ' close tasks are still outstanding as of today.')"
            }
          },
          "runAfter": {
            "Apply_to_each_task": ["Succeeded"]
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_sharepointonline": {
        "connectionName": "YOUR_SHAREPOINT_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "YOUR_OUTLOOK_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      },
      "shared_teams": {
        "connectionName": "YOUR_TEAMS_CONNECTION",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
        "tier": "NotSpecified"
      }
    }
  }
}
